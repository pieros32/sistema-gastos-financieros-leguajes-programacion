{
    "files.exclude": {
        "**/.bsp": true,
        "**/.scala-build": true,
        ".metals": true,
        ".idea": true,
        "out": true
    },
    "files.watcherExclude": {
        "**/target/**": true
    },
    "code-runner.runInTerminal": true,
    "code-runner.saveFileBeforeRun": true,
    "code-runner.executorMap": {
        "scala": "chcp 65001 ; scala-cli run --java-opt \"-Dfile.encoding=UTF-8\" --java-opt \"-Dsun.stdout.encoding=UTF-8\" $fullFileName"
    }
}
